<Page x:Class="LabApp.WPF.Pages.AuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аудит">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Аудит изменений пациентов" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Patient ID:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Text="{Binding FilterPatientId, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5,0"/>
                    <TextBlock Text="От:" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker SelectedDate="{Binding FilterFrom}" Width="100" Margin="5,0"/>
                    <TextBlock Text="До:" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker SelectedDate="{Binding FilterTo}" Width="100" Margin="5,0"/>
                    <Button Command="{Binding LoadPatientsAuditCommand}" Content="Загрузить" Margin="10,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding PatientsAudits}" AutoGenerateColumns="True" MaxHeight="250"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Аудит изменений результатов" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Referral ID:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Text="{Binding FilterReferralId, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5,0"/>
                    <TextBlock Text="Research ID:" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBox Text="{Binding FilterResearchId, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="5,0"/>
                    <Button Command="{Binding LoadResultsAuditCommand}" Content="Загрузить" Margin="10,0"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ResultsAudits}" AutoGenerateColumns="True" MaxHeight="250"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Page>