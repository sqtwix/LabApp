<Page x:Class="LabApp.WPF.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Блок дохода -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,10,0"/>
            <Button Command="{Binding LoadProfitCommand}" Content="Рассчитать доход" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Profit, StringFormat='Доход: {0:F2} руб.'}" FontWeight="Bold"/>
        </StackPanel>

        <!-- Кнопка и таблица отделений -->
        <Button Grid.Row="1" Command="{Binding LoadDepartmentsCommand}" Content="Количество сотрудников по отделениям" Margin="0,5"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Departments}" AutoGenerateColumns="True" MaxHeight="150" Margin="0,5"/>

        <!-- Кнопка и таблица пенсионеров -->
        <Button Grid.Row="3" Command="{Binding LoadPensionPatientsCommand}" Content="Пациенты пенсионного возраста" Margin="0,5"/>
        <DataGrid Grid.Row="4" ItemsSource="{Binding PensionPatients}" AutoGenerateColumns="True" Margin="0,5"/>
    </Grid>
</Page>