<Page x:Class="LabApp.WPF.Pages.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:LabApp.WPF.Converters"
      Title="Записи на приём">
    <Page.Resources>
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTimeConverter"/>
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding LoadDataCommand}" Content="⟳" Width="80" Margin="0,0,10,0"/>
            <Button Command="{Binding AddAppointmentCommand}" Content="+" Width="80"/>
        </StackPanel>

        <!-- DataGrid с записями -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Appointments}" 
                  SelectedItem="{Binding SelectedAppointment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  RowEditEnding="DataGrid_RowEditEnding"
                  SelectionChanged="DataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding AppointmentId}" IsReadOnly="True" Width="50"/>
                <DataGridTemplateColumn Header="Пациент" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Patient.LastName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Patients, RelativeSource={RelativeSource AncestorType=Page}}"
                                      DisplayMemberPath="LastName"
                                      SelectedValuePath="PatientId"
                                      SelectedValue="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Сотрудник" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Staff.LastName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Staffs, RelativeSource={RelativeSource AncestorType=Page}}"
                                      DisplayMemberPath="LastName"
                                      SelectedValuePath="StaffId"
                                      SelectedValue="{Binding StaffId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Дата" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AppointmentDate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding AppointmentDate, Converter={StaticResource DateOnlyToDateTimeConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Время" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AppointmentTime}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding AppointmentTime}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Статус – редактируемый ComboBox, при изменении вызывает UpdateStatusCommand -->
                <DataGridTemplateColumn Header="Статус" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Statuses, RelativeSource={RelativeSource AncestorType=Page}}"
                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="StatusComboBox_SelectionChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить" Command="{Binding DeleteAppointmentCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Статус‑бар с общим количеством -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding Appointments.Count, StringFormat='Всего записей: {0}'}"/>
        </StatusBar>

        <!-- Результаты анализов для выбранной записи -->
        <GroupBox Grid.Row="3" Header="Результаты анализов" Margin="0,10,0,0">
            <StackPanel>
                <Button Command="{Binding LoadResultsForAppointmentCommand}" Content="Загрузить результаты" Width="150" Margin="0,5"/>
                <DataGrid ItemsSource="{Binding SelectedAppointmentResults}" AutoGenerateColumns="True" MaxHeight="200"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Page>