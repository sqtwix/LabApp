<Window x:Class="LabApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинская лаборатория" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Пациенты" x:Name="PatientsMenuItem" Click="PatientsMenuItem_Click"/>
            <MenuItem Header="Сотрудники" x:Name="StaffMenuItem" Click="StaffMenuItem_Click"/>
            <MenuItem Header="Назначения" x:Name="AppointmentsMenuItem" Click="AppointmentsMenuItem_Click"/>
            <MenuItem Header="Отчёты" x:Name="ReportsMenuItem" Click="ReportsMenuItem_Click"/>
            <MenuItem Header="Выход" Click="ExitMenuItem_Click"/>
        </Menu>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>