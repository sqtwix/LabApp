<Window x:Class="LabApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинская лаборатория" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Меню (пока заглушка) -->
        <Menu Grid.Row="0">
            <MenuItem Header="Пациенты"/>
            <MenuItem Header="Сотрудники"/>
            <MenuItem Header="Назначения"/>
            <MenuItem Header="Отчёты"/>
        </Menu>

        <!-- Frame для контента -->
        <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>